# Copiá este archivo a .env y completá los valores. El .env nunca se sube a Git.
# Revisá que todo esté bien con: ./run.sh check

# MongoDB Atlas: mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/NOMBRE_BASE
# (si la contraseña tiene símbolos, codificalos: @ → %40, # → %23)
MONGODB_URI=

# Clave larga y aleatoria para firmar los tokens del login (podés generarla con: openssl rand -hex 32)
JWT_SECRET=

# Puerto local (en Render lo define la plataforma)
PORT=3000

# Dominios de la web que pueden usar la API, separados por coma y sin "/" al final
CORS_ORIGINS=http://localhost:8081

# Usuario del dueño: solo lo usa "npm run crear-admin"
# ADMIN_EMAIL es a donde llega el código para recuperar la contraseña
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Cloudinary (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email para recuperar la contraseña (opcional: sin esto la API anda, pero no se puede recuperar)
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=tu cuenta y SMTP_PASS una
# contraseña de aplicación (Cuenta de Google → Seguridad → Contraseñas de aplicaciones), no la de siempre.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remitente que ve el dueño, por ejemplo: Panadería Digital <tu-cuenta@gmail.com> (por defecto, SMTP_USER)
EMAIL_FROM=
